<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://namespace.org/"
           elementFormDefault="qualified">

    <xs:element name="Item">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="label" type="xs:string" minOccurs="0" default="none"/>
                <xs:element name="count" type="xs:int" minOccurs="0" default="1"/>
                <xs:element name="status" type="xs:string" default="active"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
